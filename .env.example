# Copy to .env.local and fill in real values. Never commit .env or .env.local.

# --- OpenAI (required for /tutor) ---
OPENAI_API_KEY=sk-...

# --- Feature flags ---
# The tutor is enabled by default. Set this to false only when you need to
# temporarily hide the chatbot and make /api/chat return unavailable.
# TUTOR_ENABLED=false

# --- Optional course-report email delivery ---
# Reports always go to the fixed course contact. They are never addressed using
# values supplied by the reporter. Do not use personal mailbox credentials.
# Create a Resend sending key and verify a domain you own in Resend, then set
# these server-only values in Vercel. The sender must be a bare email address on
# that verified domain. Leave the feature disabled until configuration is ready.
# Local review and deployment previews keep delivery disabled by default.
# RESEND_API_KEY=<Resend sending key>
# ITZLI_REPORT_EMAIL_FROM=<address on your verified sending domain>
# ITZLI_REPORT_EMAIL_ENABLED=1
# To send feedback from the loopback local review app, explicitly opt in below.
# Requires ITZLI_LOCAL_REVIEW=1 (set by dev:local); never enables Vercel previews.
# This uses local in-memory rate limits, with no Clerk or Neon account writes.
# ITZLI_REPORT_EMAIL_ALLOW_LOCAL=1

# --- Optional one-time signup welcome email ---
# Uses RESEND_API_KEY above. Delivery is enabled only on Vercel production;
# local builds and preview deployments never send welcome email.
# Subscribe the signed Clerk endpoint to user.created, user.updated and
# user.deleted. user.updated covers accounts that verify their email later.
# Choose a sender on your verified domain and the UTC time you enable welcomes;
# accounts created before START_AT do not receive an unexpected welcome later.
# ITZLI_WELCOME_EMAIL_FROM=hello@itzli.app
# ITZLI_WELCOME_EMAIL_ENABLED=1
# ITZLI_WELCOME_EMAIL_START_AT=2026-10-09T05:42:30Z

# --- Experimental prompt-controlled audio generation (optional) ---
# scripts/generate-openai-audio.js is useful for comparison only. It is not the
# recommended production source for Nahuatl pronunciation because general TTS can
# fall back to Spanish/English phonology. The script requires CONFIRM_TTS_SPEND=YES
# before it calls the paid TTS API.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin
# OPENAI_TTS_FORMAT=wav
# OPENAI_TTS_SPEED=0.86
# NAHUATL_TTS_INPUT_MODE=orthography
# AUDIO_OUT_DIR=public/audio

# --- Default synthetic audio: Spanish Google voice + Nahuatl exceptions ---
# Uses the existing Spanish approximation recipe; original source recordings
# take priority. Store service-account JSON in
# secrets/ or set GOOGLE_APPLICATION_CREDENTIALS to its absolute path.
# GOOGLE_APPLICATION_CREDENTIALS=C:\absolute\path\to\service-account.json
# GOOGLE_TTS_LANGUAGE_CODE=es-US
# GOOGLE_TTS_VOICE_NAME=es-US-Standard-A
# GOOGLE_TTS_AUDIO_ENCODING=LINEAR16
# GOOGLE_TTS_FORMAT=wav
# GOOGLE_TTS_SPEAKING_RATE=0.82
# GOOGLE_TTS_PITCH=0
# NAHUATL_GOOGLE_INPUT_MODE=phoneme

# --- Audio hosting override (optional) ---
# Default is /audio-google with S3 fallback in src/lib/audio.ts. To force a
# different audio source locally, use:
# NEXT_PUBLIC_AUDIO_BASE_URL=/audio-google
# NEXT_PUBLIC_AUDIO_FALLBACK_BASE_URL=https://nahuatl-language.s3.us-east-1.amazonaws.com/itzli-app

# --- Clerk (required — app auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Verifies signed user.created, user.updated and user.deleted events from Clerk.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# --- Neon Postgres (required for cloud progress sync + chat audit log) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Random secrets used for keyed audit hashes and the retention cron endpoint.
# Generate each independently, for example: openssl rand -hex 32
AUDIT_HASH_SECRET=...
CRON_SECRET=...

# --- Optional local research SQLite override (not for Vercel) ---
# The app defaults to the shipped fcn_course_release.sqlite.
# DATABASE_PATH=/absolute/path/to/local/research.sqlite

# --- Guardrail tuning (all optional) ---

# Replaces the canned refusal string returned when a message is blocked.
# Keep this out of source so attackers can't inspect the source tree for a
# sentinel that confirms a bypass succeeded.
# GUARDRAIL_REFUSAL_TEXT="<your private refusal wording here>"

# Additional hard-block regex patterns merged into the public HARD_PATTERNS
# list at startup. JSON array of {name, re} objects. Patterns are compiled
# with the `i` flag. Invalid entries are skipped with a warning.
#   Example (single line — your deploy platform may need escaped quotes):
#   GUARDRAIL_EXTRA_PATTERNS=[{"name":"rule_a","re":"secret phrase \\\\d+"},{"name":"rule_b","re":"another attack"}]
# GUARDRAIL_EXTRA_PATTERNS=

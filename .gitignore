# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local cloud credentials
/secrets/
/secret/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private research SQLite databases. Only the checked course release is shipped.
*.sqlite
!/fcn_course_release.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite.bak
*.db
*.bak

# Own learner audio; release preparation does not fetch remote assets.
/public/audio/
/public/audio-google/
image-gallery.html

# Python build artifacts (ml/* has its own .gitignore too)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Generated morphology cache — regenerate via: python -m ehn_morph build-cache --out data/morphology_cache.json
/data/

# Local review exports and temporary research downloads are not release source.
/output/
/tmp/

# clerk configuration (can include secrets)
/.clerk/
/public/audio-v3/*
!/public/audio-v3/audio-notices.json

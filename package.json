{
  "name": "amoxcalli-app",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  },
  "scripts": {
    "predev": "node scripts/fetch-db.js",
    "prebuild": "node scripts/fetch-db.js",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preverify": "node scripts/fetch-db.js",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run audit:i18n && npm run audit:app-content && npm run audit:course && npm run images:openai:audit",
    "audit:course": "node scripts/audit-course-quality.js",
    "audit:app-content": "node scripts/audit-app-content-exclusions.js",
    "audit:i18n": "node scripts/audit-spanish-localization.js",
    "images:s3:manifest": "node scripts/import-s3-word-images.js",
    "images:openai:audit": "node scripts/audit-openai-word-images.js",
    "images:openai:contact-sheets": "node scripts/make-openai-word-image-contact-sheets.js",
    "images:openai:approve": "node scripts/approve-openai-word-image.js",
    "images:openai:dry-run": "node scripts/generate-openai-word-images.js --dry-run --include-phrases",
    "images:openai:generate": "node scripts/generate-openai-word-images.js --execute --include-phrases",
    "audio:mms:test": "node scripts/run-audio-python.js --test na ta calli chilli tlahtoa xochitl quema --seeds 42 555 1337 2026",
    "audio:mms:generate": "node scripts/run-audio-python.js",
    "audio:google:dry-run": "node scripts/generate-google-audio.js --dry-run --limit 20",
    "audio:google:test": "node scripts/generate-google-audio.js --test na ta calli chilli tlahtoa xochitl quema",
    "audio:google:reviewed": "node scripts/generate-google-audio.js --reviewed",
    "audio:google:generate": "node scripts/generate-google-audio.js --execute",
    "audio:openai:dry-run": "node scripts/generate-openai-audio.js --dry-run --limit 20",
    "audio:openai:test": "node scripts/generate-openai-audio.js --test na ta calli tlahtoa xochitl quema",
    "audio:openai:generate": "node scripts/generate-openai-audio.js --execute"
  },
  "dependencies": {
    "@clerk/localizations": "^4.13.5",
    "@clerk/nextjs": "^7.5.17",
    "@neondatabase/serverless": "^1.0.2",
    "better-sqlite3": "^12.8.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.10",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}

{
  "vocab": [
    { "id": "24", "text": "axkana" },
    { "id": "25", "text": "kenihki" },
    { "id": "34", "text": "Kenihki tiya?" },
    { "id": "35", "text": "Kenihki tiistok?" },
    { "id": "260", "text": "piyali" },
    { "id": "266", "text": "tlaskamati" }
  ],
  "dialogue": [
    { "id": "CUR-11-001", "text": "Piyali." },
    { "id": "CUR-11-002", "text": "Piyali, ximopanolti." },
    { "id": "CUR-11-003", "text": "Tlaskamati." },
    { "id": "CUR-11-004", "text": "Axtlen." },
    { "id": "CUR-11-005", "text": "Asta mostlaj." },
    { "id": "CUR-11-006", "text": "Asta mostlaj." },
    { "id": "CUR-19-001", "text": "Ximoketsa." },
    { "id": "CUR-19-002", "text": "Kena." },
    { "id": "CUR-19-003", "text": "Ximotlali wan xitlapowa." },
    { "id": "CUR-19-004", "text": "Kwalli, tlaskamati." },
    { "id": "CUR-5-001", "text": "Piyali, ¿tlen titekiti ta?" },
    { "id": "CUR-5-002", "text": "Nitlamachtia nawatl." },
    { "id": "CUR-5-003", "text": "Kwalli. Na nitlahkwiloa." },
    { "id": "FCN-LDG-000028", "text": "Aah, tipaxaloti?" },
    { "id": "FCN-LDG-000046", "text": "Niyowua." },
    { "id": "FCN-LDG-000217", "text": "Ayamo. Āchtopa nimomachtia." },
    { "id": "FCN-LDG-000218", "text": "Cuālli. ¿Ācquiya mitzmachtia nāhuatl?" },
    { "id": "FCN-LDG-000219", "text": "Tlamachtihquetl nicān pan caltlamachticān. Cuālli tlahtoa nāhuatl." },
    { "id": "FCN-LDG-000242", "text": "Ayamo. Zan noconepiyah nohueltiuh huan noicniuh." },
    { "id": "FCN-LDG-000257", "text": "¿Ticpatlac motequi yalhua?" },
    { "id": "FCN-LDG-000258", "text": "Quēna, nicpatlac. ¿Huan ta?" },
    { "id": "FCN-LDG-000259", "text": "Na axcanah nicpatlac. Zan nichōcac." },
    { "id": "FCN-LDG-000260", "text": "Āmo xichoca. Āxcan cuālli." },
    { "id": "FCN-LDG-000261", "text": "¿Ticpixqui tomi yalhua?" },
    { "id": "FCN-LDG-000262", "text": "Quēna, nicpixqui tomi. ¿Huan ta?" },
    { "id": "FCN-LDG-000263", "text": "Na ninehnenqui pan āltepētl." },
    { "id": "FCN-LDG-000264", "text": "Cuālli. Na nocca nitizqui." },
    { "id": "FCN-LDG-000265", "text": "¿Titlacuāhqui yalhua?" },
    { "id": "FCN-LDG-000266", "text": "Quēna, nitlacuāhqui pan nochān." },
    { "id": "FCN-LDG-000267", "text": "¿Huan ticmachtihqui nāhuatl?" },
    { "id": "FCN-LDG-000268", "text": "Quēna, nicmachtihqui nāhuatl." },
    { "id": "FCN-LDG-000276", "text": "Axcanah xococ, nicnequi cōcoc. Tlāhuēl nicnequi cōcoc." },
    { "id": "FCN-LDG-000280", "text": "In cihuātzin nonantzin. Tlazcāmati tihuāllahqui." },
    { "id": "FCN-LDG-000283", "text": "¿Huan in chichi, cāmpa itztoc?" },
    { "id": "FCN-LDG-000284", "text": "In chichi itztoc nopā, quitemoa in piyo." },
    { "id": "FCN-LDG-000293", "text": "¿Cāmpa tiyāhqui yalhua?" },
    { "id": "FCN-LDG-000295", "text": "¿Huan tiquittac escuela?" },
    { "id": "FCN-LDG-000296", "text": "Quēna, huan niquittac in tiopa. Cuālli āltepētl." },
    { "id": "FCN-LDG-000297", "text": "¿Cuālli timomachtihqui pan āltepētl?" },
    { "id": "FCN-LDG-000298", "text": "Quēna, zan axcanah nicpixqui notiempōs. Huēhca niyāhqui." },
    { "id": "FCN-LDG-000299", "text": "¿Nōhquiya tiquittac escuela?" },
    { "id": "FCN-LDG-000300", "text": "Quēna, hasta huēhca niquittac. Cuālli āltepētl." },
    { "id": "FCN-LDG-000303", "text": "In pantzi, ōme pesos. In lalax, cē peso achiyoc." },
    { "id": "FCN-LDG-000304", "text": "Cuālli, niccui. Tlazcāmati." },
    { "id": "FCN-LDG-000312", "text": "Quēna, cuālli niitztoc. Ximotlāli, ximoāxilti." },
    { "id": "FCN-LDG-000314", "text": "Axcanah cuālli niitztoc. Nicpiya cecuīliztli." },
    { "id": "FCN-LDG-000315", "text": "¿Ticnequi pāhtli?" },
    { "id": "FCN-LDG-000318", "text": "Tlan onca tomi, quēna. Ayamo nicpiya." },
    { "id": "FCN-LDG-000320", "text": "Axcanah niccuīz nākatl. Niccuīz etl." },
    { "id": "FCN-LDG-000323", "text": "¿Huan tlan tiquittaz mixtli?" },
    { "id": "FCN-LDG-000324", "text": "Tlan niquittaz mixtli, niyāz nochān." },
    { "id": "FCN-LDG-000328", "text": "Quēna, nicnequi nitemachtia. Cuālli notequi." },
    { "id": "FCN-LDG-000332", "text": "Quēna, ipan agosto axcecec. Huan ipan enero, ¿ticpiya tequitl?" },
    { "id": "FCN-LDG-000336", "text": "Nāhui chīlli, tlazohcāmati." },
    { "id": "FCN-LDG-000339", "text": "Na nicnequi in chocolatic. Huel cuālli tlapalli." },
    { "id": "FCN-LDG-000341", "text": "¿Totōnic in tlacualli?" },
    { "id": "FCN-LDG-000342", "text": "Axcanah. Cecec in tlacualli." },
    { "id": "FCN-LDG-000343", "text": "¿Patiyoh in tlacualli?" },
    { "id": "FCN-LDG-000344", "text": "Axcanah patiyoh. Huel cuālli." },
    { "id": "FCN-LDG-000345", "text": "¿Tiquittac in ocēlōtl ipan cuauhtlah?" },
    { "id": "FCN-LDG-000346", "text": "Axcanah. Niquittac in mazatl huan cē cōātl." },
    { "id": "FCN-LDG-000347", "text": "¿Huan in toznēnē, cāmpa itztoc?" },
    { "id": "FCN-LDG-000348", "text": "In toznēnē nicān itztoc. Tlahtoa." },
    { "id": "FCN-LDG-000350", "text": "Quēna, nicchīhua eloatolli huan nicmaca chancaca. ¿Ticnequi?" },
    { "id": "FCN-LDG-000351", "text": "Quēna. ¿Huan in chīlli, cāmpa onca?" },
    { "id": "FCN-LDG-000352", "text": "In chīlli onca nicān. Huel cuālli tlacualli." },
    { "id": "FCN-LDG-000353", "text": "¿Cāmpa itztoc in āmatlahcuilōlli?" },
    { "id": "FCN-LDG-000354", "text": "In āmatlahcuilōlli nicān itztoc ipan folsah. ¿Tlen ticnequi?" },
    { "id": "FCN-LDG-000357", "text": "¿Tiquitta in hueyātl?" },
    { "id": "FCN-LDG-000358", "text": "Quēna. In hueyātl nel huēyi." },
    { "id": "FCN-LDG-000359", "text": "¿Huan in xālli, cāmpa onca?" },
    { "id": "FCN-LDG-000360", "text": "Nicān onca xālli huan zoyatl." },
    { "id": "FCN-LDG-000361", "text": "¿Tlen tictemoa ipan āltepētl?" },
    { "id": "FCN-LDG-000362", "text": "Nictemoa nocnīuh. ¿Huan ta, cāmpa tiyāuh?" },
    { "id": "FCN-LDG-000363", "text": "Na niyāuh ipan chinanco." },
    { "id": "FCN-LDG-000364", "text": "Quēna, in chinanco cuālli." },
    { "id": "FCN-LDG-000366", "text": "Nipixca pan mīllah huan nitlahcuiloa. ¿Huan ta?" },
    { "id": "FCN-LDG-000370", "text": "Axcanah nel miac. Yōlic yōlic nimomachtia. ¿Huan ta?" },
    { "id": "FCN-LDG-000371", "text": "Na nochipa nimomachtia nicān caltlamachticān." },
    { "id": "FCN-LDG-000372", "text": "Huel cuālli. Ocsepa titlahtōzqueh." }
  ]
}
